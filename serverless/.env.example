# Twilio account credentials (required).
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=your_auth_token

# API key/secret used by /sync-token to mint Sync access tokens for the plugin
# (required if SYNC_SERVICE_SID is set).
# Create with: twilio api:core:keys:create --friendly-name=plugin-whatsapp-outbound-sync
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=

# WhatsApp sender (E.164 with the whatsapp: prefix stripped in code).
WHATSAPP_FROM=+15551234567

# TaskRouter: workspace + workflow + default queue used when creating
# interactions and tasks for outbound WA conversations.
TASKROUTER_WORKSPACE_SID=WSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TASKROUTER_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TASKROUTER_QUEUE_SID=WQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TaskRouter task channel unique_name used when creating new chat tasks.
# Default 'chat'. Change only if your workspace defines a custom channel.
TASK_CHANNEL_NAME=chat

# Flex Interactions channel type shown to agents on the task card.
CHANNEL_TYPE=whatsapp

# Twilio Sync service SID (required for per-agent send history + team view).
# If unset, the plugin's tracking panel will silently stay empty.
SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ISO 8601 auto-close timer applied to every outbound conversation.
# Twilio enforces a 10-minute minimum (PT10M); below that the API will reject.
AUTO_CLOSE_AFTER=P5D

# WhatsApp 24-hour Customer Service Window threshold enforced by the pre-webhook.
# Change only if your messaging policy differs from Meta's standard CSW.
WA_WINDOW_HOURS=24

# Lifetime of Sync access tokens minted for the plugin, in seconds.
SYNC_TOKEN_TTL_SECONDS=3600
