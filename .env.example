# Base URL of the deployed twilio-run service (no trailing slash).
FLEX_APP_FUNCTIONS_BASE_URL=https://plugin-whatsapp-outbound-XXXX-dev.twil.io

# UI label shown in the Flex side-nav. Default "WhatsApp Outbound".
FLEX_APP_SIDE_NAV_LABEL=WhatsApp Outbound

# Expose the "All agents" toggle in the Open conversations panel. true|false.
FLEX_APP_ENABLE_TEAM_VIEW=true

# Expose the Park (me) / Park (all) buttons on the task canvas. true|false.
# Set false for fire-and-forget deployments that never park.
FLEX_APP_ENABLE_PARK=true

# Which send mode is preselected on the composer: open-chat|same-agent|any-agent.
FLEX_APP_DEFAULT_SEND_MODE=open-chat

# WhatsApp Customer Service Window in hours. Must match the serverless
# WA_WINDOW_HOURS so UI and policy stay in sync. Default 24.
FLEX_APP_WA_WINDOW_HOURS=24
